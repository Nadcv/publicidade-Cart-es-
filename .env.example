# Copia para .env (local) ou configura estas variáveis no dashboard da Vercel
# (Project Settings > Environment Variables). NUNCA commites o .env real.

# --- Stripe (dashboard.stripe.com > Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# URL pública do site (para os redirects de sucesso/cancelamento do Checkout)
PUBLIC_SITE_URL=https://o-teu-dominio.vercel.app

# --- Supabase (dashboard.supabase.com > Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Service role key (tem acesso total, só é usada no servidor, nunca no browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Gelato (dashboard.gelato.com > Developers > API keys) ---
GELATO_API_KEY=...
# UID exato do produto no catálogo da Gelato, um por formato IMPRESSO vendido.
# "convite-digital" e "nfc" não precisam de nenhum UID: nunca passam pela Gelato — o
# primeiro é entregue por e-mail, o segundo é um chip físico preparado à mão (ver
# lib/formats.js e a secção "Chip NFC" do README). Confirma antes de ir a produção:
# GET https://product.gelatoapis.com/v3/products:search com o teu GELATO_API_KEY, filtrando
# por "business card" / "flyer" / "invitation" no tamanho/acabamento que quiseres vender.
# Copia o "productUid" devolvido — os valores abaixo são só placeholders e podem não existir.
GELATO_PRODUCT_UID_CARD=cards_pf_bx-w-89-h-51_pt_350-gsm-coated-silk_cl_4-4_ct_none-none_ft_none
GELATO_PRODUCT_UID_FLYER=flyers_pf_a5_pt_170-gsm-coated-silk_cl_4-4_ct_none-none_ft_none
GELATO_PRODUCT_UID_CONVITE=cards_pf_a6_pt_350-gsm-coated-silk_cl_4-4_ct_none-none_ft_none

# --- Preço (em cêntimos, moeda = currency abaixo) por formato + escalão de quantidade ---
# Ajusta depois de saberes o custo real (impressão + envio, ou o custo dos chips NFC em
# branco) para a tua margem. Formato: "formato:quantidade:preco_centimos,...".
# "card": quantidade mínima de encomenda é 5 unidades (confirma com a Gelato se o
# productUid escolhido aceita tiragens tão pequenas antes de vender a sério).
# "convite" é impresso (pequenas tiragens, ótimo para casamentos/festas); "convite-digital"
# é só o ficheiro, entregue por e-mail (sem Gelato, sem morada de envio) — usa sempre
# quantidade 1 nessa linha. "nfc" é o chip físico com o Cartão Digital gravado (ver README);
# o preço já deve cobrir o custo do chip em branco + o teu tempo a gravá-lo e enviá-lo.
PRICE_TABLE=card:5:699,card:10:999,card:20:1499,card:50:1999,card:100:2999,card:250:4999,card:500:7999,flyer:50:1999,flyer:100:3499,flyer:250:6999,convite:5:1499,convite:10:1999,convite:20:2999,convite:50:4999,convite:100:7999,convite-digital:1:990,nfc:1:1499,nfc:2:2499,nfc:5:4999
CURRENCY=eur

# --- E-mail de confirmação (resend.com — opcional, mas recomendado) ---
# Sem isto configurado, o site funciona na mesma, só não envia o e-mail de confirmação.
RESEND_API_KEY=re_...
# Antes de verificares um domínio próprio na Resend, "onboarding@resend.dev" já funciona
# para testar. Depois de verificares o teu domínio, troca para algo como
# "UniAds Studio <pedidos@o-teu-dominio.com>".
EMAIL_FROM=UniAds Studio <onboarding@resend.dev>

# --- Painel de administração (/admin.html) ---
# Escolhe uma palavra-passe forte só tua — sem isto definido, o painel fica desativado.
ADMIN_PASSWORD=escolhe-uma-palavra-passe-forte

# --- Códigos de referência (opcional) ---
# ID de um cupão criado no dashboard da Stripe (Product catalog > Coupons), ex: um
# desconto de 10%. Depois de cada pedido pago, geramos um código de promoção único
# ligado a este cupão e mostramos ao cliente para ele partilhar com amigos. Sem esta
# variável, o site funciona na mesma, só não gera códigos de referência.
REFERRAL_COUPON_ID=
